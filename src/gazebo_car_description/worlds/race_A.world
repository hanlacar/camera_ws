    <!-- Race A: 0.35 m obstacle centered on the upper straight white line. -->
    <model name="race_A_obstacle">
      <static>true</static>
      <!-- Asphalt collision top is z=0.02, so 0.02 + 0.35 / 2 = 0.195. -->
      <pose>1.5 3.225 0.195 0 0 0</pose>
      <link name="race_A_obstacle_link">
        <collision name="race_A_obstacle_collision">
          <geometry>
            <box>
              <size>0.25 0.25 0.35</size>
            </box>
          </geometry>
        </collision>
        <visual name="race_A_obstacle_visual">
          <geometry>
            <box>
              <size>0.25 0.25 0.35</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Race A: 3.0 m wide-road bump on the lower straight, centered at x=0.0, y=-3.0.
      The x footprint is 1.2 m ascent, 0.6 m flat crest, and 1.2 m descent.
      Slope angles ease through 8/16/22/26 degrees before the flat crest,
      then mirror back down to avoid a sharp peak.
    -->
