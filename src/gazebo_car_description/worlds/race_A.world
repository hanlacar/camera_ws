    <!-- Race A stop line: used as the lap checkpoint line on the upper straight. -->
    <model name="race_A_stop_line">
      <static>true</static>
      <pose>-1.0 3.0 0 0 0 0</pose>
      <link name="stop_line_link">
        <visual name="stop_line_visual">
