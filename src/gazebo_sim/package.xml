<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gazebo_sim</name>
  <version>0.1.0</version>
  <description>
    Gazebo (gz-sim8) simulation for the turtle_car: S-curve world, camera+IMU
    sensor sized to the real vehicle, a /camera_drive+/camera_wheel to /cmd_vel
    adapter, and launch files that run the real YOLO camera stack (BEV and
    non-BEV variants) against the simulated camera.
  </description>
  <maintainer email="dev@example.com">race team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>camera_navigation</exec_depend>
  <exec_depend>camera_yolo_inference</exec_depend>
  <exec_depend>race_interfaces</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
